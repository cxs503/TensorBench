{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorbench.dev/schemas/evidence_bundle.json",
  "title": "TensorBench mission evidence bundle",
  "description": "Immutable, self-describing evidence package for one TensorPlatform mission: mission metadata, associated PR/commit, CI conclusion, per-deliverable SHA-256 fingerprints, collection timestamp and an explicit list of missing items. Absent evidence is recorded as the literal string \"missing\" and repeated in the `missing` array; it is never inferred or synthesized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "mission_id",
    "collected_at",
    "collector",
    "platform",
    "mission",
    "commit",
    "pull_request",
    "ci",
    "deliverables",
    "missing",
    "source_fingerprints",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "tensorbench.evidence_bundle" },
    "mission_id": { "type": "integer", "minimum": 1 },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp of the read-only collection run."
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "mode"],
      "properties": {
        "name": { "const": "tensorbench" },
        "version": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["live_read_only"] }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_base", "mission_endpoint", "payload_sha256"],
      "properties": {
        "api_base": { "type": "string", "minLength": 1 },
        "mission_endpoint": { "type": "string", "minLength": 1 },
        "payload_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "mission": { "$ref": "#/$defs/mission" },
    "commit": {
      "oneOf": [{ "$ref": "#/$defs/commit" }, { "const": "missing" }]
    },
    "pull_request": {
      "oneOf": [{ "$ref": "#/$defs/pullRequest" }, { "const": "missing" }]
    },
    "ci": {
      "oneOf": [{ "$ref": "#/$defs/ci" }, { "const": "missing" }]
    },
    "deliverables": {
      "type": "array",
      "items": { "$ref": "#/$defs/deliverable" }
    },
    "missing": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Explicit paths of every field that could not be evidenced."
    },
    "source_fingerprints": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/maybeSha256" },
      "description": "SHA-256 of the canonical JSON of every raw upstream payload used to build this bundle."
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_sha256", "digest_scope"],
      "properties": {
        "bundle_sha256": { "$ref": "#/$defs/sha256" },
        "digest_scope": {
          "const": "canonical_json_of_bundle_excluding_integrity"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present only for bundles checked into tests/fixtures: provenance of the recorded raw upstream payloads.",
      "required": ["recorded_raw_path", "recorded_raw_sha256"],
      "properties": {
        "recorded_raw_path": { "type": "string", "minLength": 1 },
        "recorded_raw_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "maybeSha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "const": "missing" }]
    },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$" },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repo", "status", "goal_sha256", "result_sha256"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "claimed_by": { "type": ["string", "null"] },
        "created_at": { "type": ["string", "null"] },
        "finished_at": { "type": ["string", "null"] },
        "goal": { "type": ["string", "null"] },
        "goal_sha256": { "$ref": "#/$defs/maybeSha256" },
        "result_sha256": { "$ref": "#/$defs/maybeSha256" }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "source", "matches_mission_head"],
      "properties": {
        "sha": { "$ref": "#/$defs/commitSha" },
        "source": { "enum": ["pull_request.head", "mission_result.head_commit"] },
        "matches_mission_head": {
          "oneOf": [{ "type": "boolean" }, { "const": "inconclusive" }],
          "description": "True/False when the mission payload declares its own immutable head commit, otherwise inconclusive."
        }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "state",
        "merged",
        "merged_at",
        "merge_commit_sha",
        "head_ref",
        "head_sha",
        "base_ref",
        "changed_files",
        "additions",
        "deletions",
        "html_url",
        "resolution"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "state": { "type": "string", "minLength": 1 },
        "merged": { "type": ["boolean", "null"] },
        "merged_at": { "type": ["string", "null"] },
        "merge_commit_sha": { "oneOf": [{ "$ref": "#/$defs/commitSha" }, { "type": "null" }] },
        "head_ref": { "type": "string", "minLength": 1 },
        "head_sha": { "$ref": "#/$defs/commitSha" },
        "base_ref": { "type": "string", "minLength": 1 },
        "changed_files": { "type": ["integer", "null"], "minimum": 0 },
        "additions": { "type": ["integer", "null"], "minimum": 0 },
        "deletions": { "type": ["integer", "null"], "minimum": 0 },
        "html_url": { "type": ["string", "null"] },
        "resolution": {
          "enum": ["branch_head", "commit_association"],
          "description": "How the PR was tied to the mission: head branch agent/m<id>, or the PR that contains the mission-declared head commit."
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "check_runs", "statuses", "total_count"],
      "properties": {
        "conclusion": { "enum": ["passed", "failed", "not_run", "inconclusive"] },
        "check_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "conclusion"],
            "properties": {
              "name": { "type": "string" },
              "status": { "type": ["string", "null"] },
              "conclusion": { "type": ["string", "null"] }
            }
          }
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["context", "state"],
            "properties": {
              "context": { "type": "string" },
              "state": { "type": ["string", "null"] }
            }
          }
        },
        "total_count": { "type": "integer", "minimum": 0 }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "additions", "deletions", "blob_sha", "sha256", "bytes", "origin"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "additions": { "type": ["integer", "null"], "minimum": 0 },
        "deletions": { "type": ["integer", "null"], "minimum": 0 },
        "blob_sha": { "type": ["string", "null"] },
        "sha256": { "$ref": "#/$defs/maybeSha256" },
        "bytes": { "type": ["integer", "null"], "minimum": 0 },
        "origin": {
          "type": "string",
          "description": "Where the fingerprint came from, e.g. github_contents@<commit sha>."
        }
      }
    }
  }
}