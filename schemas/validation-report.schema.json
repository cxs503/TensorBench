{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TensorBench Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "product_version",
    "run_id",
    "created_at",
    "input_refs",
    "checks",
    "findings",
    "overall_status",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "product_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "version",
          "method",
          "state"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "method": {
            "enum": [
              "deterministic_rule",
              "numerical_test",
              "statistical_test",
              "model_assisted",
              "human_review"
            ]
          },
          "state": {
            "enum": [
              "passed",
              "failed",
              "not_measured",
              "not_applicable",
              "inconclusive"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "check_id",
          "status",
          "severity",
          "summary",
          "evidence_refs",
          "review_state"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "check_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "confirmed",
              "likely",
              "inconclusive",
              "not_applicable"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "summary": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counter_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_state": {
            "enum": [
              "unreviewed",
              "accepted",
              "rejected",
              "amended"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "overall_status": {
      "enum": [
        "passed",
        "failed",
        "inconclusive",
        "partial"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "input_fingerprints"
      ],
      "properties": {
        "input_fingerprints": {
          "type": "object"
        },
        "software_revision": {
          "type": "string"
        },
        "configuration_sha256": {
          "type": "string"
        },
        "model": {
          "type": "object"
        },
        "review_events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
